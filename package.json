{
  "name": "iyansr.id-reborn",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@swc/core"
    ],
    "overrides": {
      "postcss-selector-parser@<6.1.5": "^6.1.5"
    }
  },
  "scripts": {
    "dev": "vite dev --port 2718 --no-open",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "format": "oxfmt src vite.config.ts",
    "format:check": "oxfmt --check src vite.config.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "oxlint && oxfmt --check src vite.config.ts"
  },
  "dependencies": {
    "@cf-wasm/og": "^0.5.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@tabler/icons-react": "^3.51.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-devtools": "^0.4.6",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.3",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.5",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.476.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "rehype-pretty-code": "^0.14.6",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "^4.3.5",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.68.0",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "jsdom": "^26.1.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.93.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "web-vitals": "^4.2.4",
    "wrangler": "^4.160.0"
  }
}

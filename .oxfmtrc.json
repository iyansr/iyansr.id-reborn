{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "es5",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "singleAttributePerLine": false,
  "sortImports": {
    "groups": [
      "builtin",
      "external",
      "internal",
      [
        "parent",
        "sibling",
        "index"
      ]
    ],
    "internalPattern": [
      "~/",
      "@/",
      "#"
    ],
    "newlinesBetween": true
  },
  "overrides": [
    {
      "files": [
        "**/*.css"
      ],
      "options": {
        "singleQuote": false
      }
    }
  ],
  "ignorePatterns": [
    "src/routeTree.gen.ts",
    "src/content/**",
    "dist/**/*"
  ]
}
